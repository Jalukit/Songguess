{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "tsBuildInfoFile": "node_modules/.tmp/app.tsbuildinfo"
  },
  "include": ["src/client", "src/shared"],
  "exclude": ["src/**/*.test.ts"]
}
